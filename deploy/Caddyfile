{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
		-Server
	}
	file_server
}
